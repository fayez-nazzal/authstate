{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": {
      "@account/*": ["./src/account/*"],
      "@jar/*": ["./src/jar/*"],
      "@freshness/*": ["./src/freshness/*"],
      "@login-turn/*": ["./src/login-turn/*"],
      "@signin-proof/*": ["./src/signin-proof/*"],
      "@login/*": ["./src/login/*"],
      "@verdict/*": ["./src/verdict/*"],
      "@ensure/*": ["./src/ensure/*"],
      "@invocation/*": ["./src/invocation/*"]
    }
  }
}
