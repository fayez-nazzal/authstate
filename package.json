{
  "name": "authstate",
  "version": "0.3.0",
  "description": "CLI for AI coding agents. Logs in once and maintains a shared Playwright storageState cookie jar so no other tool handles a password.",
  "keywords": [
    "ai-agents",
    "agent-tools",
    "claude-code",
    "codex",
    "antigravity",
    "grok-cli",
    "cursor",
    "opencode",
    "agentic",
    "cli",
    "playwright",
    "storagestate",
    "authentication",
    "login",
    "session",
    "cookie-jar"
  ],
  "type": "module",
  "bin": {
    "authstate": "src/main.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
